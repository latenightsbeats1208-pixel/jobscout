# Artefacts de build — jamais versionnés.
dist/
output/
vendor/
launcher/out/
assets/jobscout.ico
assets/JobScout.icns
assets/JobScout.iconset/

# Matériel de signature de code — JAMAIS versionné. Le certificat vit HORS du
# dépôt ; chemin et mot de passe passent par l'environnement (voir sign.mjs).
# Mac : certificat Developer ID (.p12), clé de notarisation (.p8), trousseau
# temporaire (.keychain-db), tous fournis par les secrets du dépôt en CI.
*.pfx
*.p12
*.p8
*.keychain-db
*.cer
*.crt
*.key

# Identité de l'opérateur utilisée par check-leaks.mjs.
# Ce fichier contient précisément les données qu'on cherche à protéger :
# il ne doit JAMAIS entrer dans le dépôt.
leak-needles.local.txt
leak-needles.operator.txt
