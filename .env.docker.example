# Copiez ce fichier en .env (à côté de docker-compose.yml) et remplissez-le.

# Nom d'hôte sous lequel vous ouvrez JobScout via Tailscale
# (ex. le nom MagicDNS de votre homelab, ou un sous-domaine routé par Traefik).
JOBSCOUT_HOST=jobscout.homelab.tail1234.ts.net

# Mot de passe de connexion à JobScout.
JOBSCOUT_PASSWORD=

# Heure du scan automatique quotidien (HH:MM, fuseau TZ). Vide = désactivé.
JOBSCOUT_DAILY_SCAN=06:30
TZ=Europe/Paris

# Réseau Docker partagé avec Traefik, et entrypoint Traefik à utiliser
# (« web » = HTTP:80, « websecure » = HTTPS:443 si vous avez un certificat).
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=web

# 0 = image sans le moteur LinkedIn (plus légère).
WITH_LINKEDIN=1

# France Travail — API officielle (optionnel, plus fiable que les pages publiques).
# FT_CLIENT_ID=
# FT_CLIENT_SECRET=
